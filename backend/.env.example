# ============================================================
# AFC SOFT AUDIT — CONFIGURATION BACKEND
# ============================================================


# ============================================================
# BASE DE DONNÉES — SUPABASE POSTGRESQL
# ============================================================

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres


# ============================================================
# AUTHENTIFICATION JWT
# ============================================================

AFCSOFT_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET


# ============================================================
# GOOGLE OAUTH 2.0
# ============================================================

GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID

GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET

GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/google/oauth/callback


# ============================================================
# GOOGLE OAUTH — REFRESH TOKEN
# ============================================================

GOOGLE_OAUTH_REFRESH_TOKEN=


# ============================================================
# GOOGLE SHARED DRIVE
# ============================================================

GOOGLE_SHARED_DRIVE_ID=YOUR_SHARED_DRIVE_ID

# ============================================================
# SÉCURITÉ — CORS
# ============================================================
# Liste des origines autorisées à appeler l'API, séparées par
# des virgules. Le joker "*" n'est PAS accepté.
#
# Exemple en production :
#   CORS_ALLOWED_ORIGINS=https://audit.afc-audit.com

CORS_ALLOWED_ORIGINS=http://localhost:3000


# ============================================================
# SÉCURITÉ — REVERSE PROXY
# ============================================================
# À passer à true UNIQUEMENT si l'API est déployée derrière un
# reverse proxy de confiance (Nginx, Caddy, Render, Railway...).
#
# La limitation anti brute-force utilise alors l'en-tête
# X-Forwarded-For pour identifier la vraie IP du client.
#
# Si l'API est exposée directement à Internet, laisser false :
# cet en-tête serait falsifiable par un attaquant.

TRUST_PROXY_HEADERS=false


# ============================================================
# COMPTE ASSOCIÉ INITIAL
# ============================================================
# Utilisé UNIQUEMENT au tout premier démarrage, lorsque la base
# ne contient encore aucun utilisateur.
#
# Si le mot de passe est laissé vide, un mot de passe aléatoire
# est généré et affiché une seule fois dans la console du
# serveur. Dans tous les cas, il doit être changé à la première
# connexion.

AFCSOFT_BOOTSTRAP_EMAIL=associe@afc-audit.com
AFCSOFT_BOOTSTRAP_PASSWORD=
